{
    "name": "chatbot-creator/studio",
    "description": "ChatBot Creator Studio - Multi-Tenant AI Chatbot Creation SaaS Platform (PHP 8.3+ Native, Zero Frameworks)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "php tests/run-tests.php",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php"
    }
}
